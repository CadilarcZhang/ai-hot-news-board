    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "mongoose": "^9.1.2",
    "pg": "^8.16.3",
    "socks-proxy-agent": "^8.0.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "playwright": "^1.57.0",
    "puppeteer": "^24.34.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
