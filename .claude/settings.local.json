{
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(curl:*)",
      "Bash(node:*)",
      "Bash(pkill:*)",
      "Bash(lsof:*)",
      "Bash(xargs kill:*)",
      "Bash(PORT=3001 BASE_PATH=\"/hot-news\" node:*)",
      "Bash(PORT=3001 node:*)",
      "Bash(kill:*)",
      "Bash(tee:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-tool-call.py"
          }
        ]
      }
    ]
  }
}