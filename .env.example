# Vercel Environment Variables
# Copy this file to .env and fill in the values

# TianAPI Key (hot news data source)
TIANAPI_KEY=

# SiliconFlow AI API Key (AI content generation)
AI_API_KEY=

# Google Custom Search API
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Google Search Switch (true/false)
GOOGLE_SEARCH_SWITCH=false

# Admin API security
# Required for /api/cache-stats and /api/cache-warmup
ADMIN_API_TOKEN=
# Comma-separated allowed origins for admin endpoints
ADMIN_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3001
BASE_PATH=/hot-news
