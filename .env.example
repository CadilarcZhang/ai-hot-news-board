# Vercel Environment Variables
# Copy this file to .env and fill in the values

# TianAPI Key (hot news data source)
TIANAPI_KEY=

# SiliconFlow AI API Key (AI content generation)
AI_API_KEY=

# Google Custom Search API（联网摘要的主搜索；失败时回退百度）
# GOOGLE_SEARCH_SWITCH=true（忽略大小写）且下面两项都有值时启用 Google。
# GOOGLE_SEARCH_SWITCH=false 时关闭 Google，即使密钥已填写。
# 不设置 GOOGLE_SEARCH_SWITCH 时，只要 API Key 和 Engine ID 都存在就自动启用 Google。
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
GOOGLE_SEARCH_SWITCH=true

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3001
BASE_PATH=/hot-news