{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*(?:[._-])[a-fA-F0-9]{8,}\\.(js|css|mjs|woff2|woff|ttf|eot|png|jpg|jpeg|gif|svg|ico|webp))",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/public/$1"
    },
    {
      "src": "/(.*\\.(woff2|woff|ttf|eot|png|jpg|jpeg|gif|svg|ico|webp))",
      "headers": {
        "Cache-Control": "public, max-age=2592000, stale-while-revalidate=31536000"
      },
      "dest": "/public/$1"
    },
    {
      "src": "/(.*\\.(js|css|mjs|webmanifest))",
      "headers": {
        "Cache-Control": "public, max-age=60, s-maxage=60, stale-while-revalidate=86400"
      },
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "env": {
    "BASE_PATH": ""
  }
}
